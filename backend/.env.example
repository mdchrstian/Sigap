SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase format:
# postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Use the Session pooler (port 5432) or the direct connection, NOT the Transaction pooler (6543).
DATABASE_URL=postgres://sigap:sigap@localhost:54329/sigap
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_BACKEND=local
SUPABASE_S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY=dummy-access-key
SUPABASE_S3_SECRET_KEY=dummy-secret-key
SUPABASE_BUCKET=sigap
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Sigap/0.1 (Bali DigiFest 2026 demo)
DUP_RADIUS_M=100
DUP_WINDOW_DAYS=90
DUP_HIGH_SIM=0.88
DUP_HIGH_MAX_DIST_M=50
DUP_MEDIUM_SIM=0.75
DUP_MAX_CANDIDATES=5
DEMO_PASSWORD=SigapDemo2026!
